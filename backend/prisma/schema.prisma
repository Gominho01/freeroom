generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_REMINDER
  WAITLIST_AVAILABLE
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  avatarSeed String
  role       Role     @default(USER)
  createdAt  DateTime @default(now())

  bookings        Booking[]
  notifications   Notification[]
  waitlistEntries WaitlistEntry[]
}

model Room {
  id        String   @id @default(cuid())
  name      String
  nickname  String
  quirks    String[]
  capacity  Int
  amenities String[]
  photos    String[] @default([])
  createdAt DateTime @default(now())

  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
}

model Booking {
  id             String    @id @default(cuid())
  roomId         String
  userId         String
  startTime      DateTime
  endTime        DateTime
  // Shared by every occurrence of a recurring booking, null for a one-off.
  recurrenceId   String?
  // Set once the "starting soon" reminder has fired, so the poller never
  // sends it twice.
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([roomId, startTime, endTime])
  @@index([recurrenceId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// A user asking to be told when a room frees up for a time range that's
// already booked. No hold/priority on the slot — once it's free, it's
// first-come-first-served like any other booking.
model WaitlistEntry {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, startTime, endTime])
}
