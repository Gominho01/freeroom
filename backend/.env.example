DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freeroom
# Required — no default. Generate a real random value for anything beyond
# local dev, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me
PORT=3333
# Comma-separated allowed origins for CORS (REST + Socket.io). Leave unset
# locally. In production, set this to the deployed frontend's URL(s), e.g.:
# CORS_ORIGIN=https://freeroom.vercel.app
